# ============================================================================
# IssuePilot 环境变量模板
# 复制为 .env 后填写实际值。.env 文件不得提交。
# PoC 阶段（里程碑 1.0）只需填写 [PoC] 标记的项。
# ============================================================================

# ----------------------------------------------------------------------------
# LLM API Keys  [PoC]
# ----------------------------------------------------------------------------
# Anthropic 认证 —— 二选一：
#   (A) 直连 Anthropic：填 ANTHROPIC_API_KEY（sk-ant- 开头）
#   (B) 中转/代理：填 ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN，留空 ANTHROPIC_API_KEY
# Claude Code CLI 优先使用 ANTHROPIC_AUTH_TOKEN（如果同时设置）。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Claude Code CLI 可选优化（中转 API 通常需要）
# 1 = 关闭遥测/分析等非必要流量；0 = 关闭 Claude Code 归属请求头
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_ATTRIBUTION_HEADER=0

# Fallback：DeepSeek 的 Anthropic 兼容接口（PoC 已验证可用作 Agent B 兜底）
# 与 models.yaml 中 agent_b.fallback 字段配套
DEEPSEEK_ANTHROPIC_TOKEN=

# 以下可选，启用对应厂商时再填（直接走各厂商原生 API）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ----------------------------------------------------------------------------
# GitHub  [PoC 部分需要]
# ----------------------------------------------------------------------------
# 抓取 Issue 用，只需 public_repo 权限即可
GITHUB_TOKEN=ghp_

# Fork + PR 提交用，需要 repo 权限
# PoC 阶段可与 GITHUB_TOKEN 相同；正式版建议拆分为独立机器人账号
GITHUB_DEV_TOKEN=ghp_

# 提交 PR 的 GitHub 用户名（Fork 的归属账号）
GITHUB_USERNAME=

# Webhook HMAC 签名密钥（接收 PR merge/close 事件）；PoC 阶段可留空
GITHUB_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 数据库 / Redis（里程碑 1.1 起需要，PoC 可忽略）
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://issuepilot:issuepilot@localhost:5432/issuepilot
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------------
# Agent B 沙箱  [PoC]
# ----------------------------------------------------------------------------
# 沙箱镜像名前缀，运行时拼接为 ${SANDBOX_IMAGE_PREFIX}-{python|node|go|...}
SANDBOX_IMAGE_PREFIX=agent-sandbox

# 单任务超时（分钟）；PoC 用较小值便于调试
DEV_TASK_TIMEOUT_MINUTES=20

# Agent B ReAct 最大轮数（headless --max-turns）
AGENT_B_MAX_TURNS=25

# 依赖缓存目录（宿主机路径，会挂载到沙箱内）
# Windows 注意：Docker Desktop 需在 Settings → Resources → File Sharing 中授权
SANDBOX_CACHE_DIR=./.sandbox_cache

# 沙箱工作区根目录（每个任务一个子目录）
SANDBOX_WORKSPACE_DIR=./.sandbox_workspaces

# ----------------------------------------------------------------------------
# 应用配置（里程碑 1.2+ 生效）
# ----------------------------------------------------------------------------
CRAWL_SCHEDULE=0 8 * * *
MAX_ANALYZE_WORKERS=3
MAX_DEV_WORKERS=2
MAX_REVIEW_WORKERS=3
MAX_DEV_RETRY=2
MAX_REVIEW_RETRY=3

# ----------------------------------------------------------------------------
# 可观测性（里程碑 2.x 生效）
# ----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
